<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ValheimModManager.App.ViewModels"
        xmlns:m="using:ValheimModManager.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="ValheimModManager.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="Valheim Mod Manager"
        Width="1140" Height="740"
        MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid Background="#18181b">
        <!-- BASE APP LAYOUT -->
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            
            <!-- HEADER & TOOLBAR -->
            <Border Grid.Row="0" Background="#27272a" Padding="12,8" BorderBrush="#3f3f46" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- Left: Title & Profile Selector with Streamlined Management -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Brand -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="/Assets/icon.png" Width="30" Height="30" VerticalAlignment="Center" />
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="VALHEIM" FontWeight="Black" FontSize="16" Foreground="#e4e4e7" LetterSpacing="1.5" />
                                <TextBlock Text="MOD MANAGER" FontSize="9" Foreground="#a1a1aa" FontWeight="SemiBold" LetterSpacing="0.8" />
                            </StackPanel>
                        </StackPanel>
                        
                        <Rectangle Width="1" Height="26" Fill="#3f3f46" Margin="2,0" />
                        
                        <!-- Profile Selection & Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.HeaderProfileLabel}" VerticalAlignment="Center" Foreground="#a1a1aa" FontSize="12" FontWeight="Medium" />
                            <ComboBox ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      Width="130" />

                            <!-- Quick Create Profile -->
                            <Button Content="➕" 
                                    Command="{Binding ShowNewProfileDialogCommand}"
                                    ToolTip.Tip="{Binding Strings.HeaderTooltipNewProfile}"
                                    Background="#3f3f46" Padding="7,6" CornerRadius="4" />

                            <!-- More Profile Options Menu (Clone, Delete, Export, Import) -->
                            <Button Content="⚙️" ToolTip.Tip="{Binding Strings.HeaderTooltipProfileOptions}"
                                    Background="#3f3f46" Padding="7,6" CornerRadius="4">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="{Binding Strings.HeaderMenuCloneProfile}" Command="{Binding CloneActiveProfileCommand}" />
                                        <MenuItem Header="{Binding Strings.HeaderMenuDeleteProfile}" Command="{Binding DeleteCurrentProfileCommand}" />
                                        <Separator />
                                        <MenuItem Header="{Binding Strings.HeaderMenuShareProfileCode}" Command="{Binding ShowShareProfileDialogCommand}" />
                                        <MenuItem Header="{Binding Strings.HeaderMenuExportProfile}" Click="OnExportProfileClicked" />
                                        <MenuItem Header="{Binding Strings.HeaderMenuExportServer}" Click="OnExportServerPackageClicked" />
                                        <Separator />
                                        <MenuItem Header="{Binding Strings.HeaderMenuImportShareCode}" Command="{Binding ShowImportShareCodeDialogCommand}" />
                                        <MenuItem Header="{Binding Strings.HeaderMenuImportVmmProfile}" Click="OnImportVmmProfileClicked" />
                                        <MenuItem Header="{Binding Strings.HeaderMenuImportR2z}" Click="OnImportR2zClicked" />
                                        <MenuItem Header="{Binding Strings.HeaderMenuImportR2Code}" Command="{Binding ShowImportR2CodeDialogCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: BepInEx Status Pill (Centered, strictly contained) -->
                    <Border Grid.Column="1" Background="#18181b"
                            BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6"
                            Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            ClipToBounds="True"
                            ToolTip.Tip="{Binding BepInExStatusTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding BepInExStatusColor}" />
                            <TextBlock Text="{Binding BepInExStatusText}" 
                                       Foreground="#e4e4e7" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            <Button Content="{Binding Strings.HeaderInstallBepInExShort}" 
                                    Command="{Binding InstallBepInExCommand}"
                                    IsVisible="{Binding !IsBepInExInstalled}"
                                    Background="#d97706" Foreground="White" FontSize="11" FontWeight="Bold" Padding="8,3" CornerRadius="4" />
                            <Button Content="{Binding Strings.HeaderRestoreVanillaShort}" 
                                    Command="{Binding RestoreVanillaCommand}"
                                    IsVisible="{Binding IsBepInExInstalled}"
                                    Background="#3f3f46" Foreground="#d4d4d8" FontSize="11" Padding="8,3" CornerRadius="4" />
                        </StackPanel>
                    </Border>

                    <!-- Right: Primary Play Actions (Always visible and anchored right) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="{Binding Strings.HeaderLaunchGameButton}" 
                                Command="{Binding LaunchGameCommand}"
                                Background="#16a34a" Foreground="White" 
                                FontWeight="Bold" FontSize="12"
                                Padding="14,9" CornerRadius="6" />
                        
                        <Button Content="{Binding Strings.HeaderLaunchServerButton}" 
                                Command="{Binding LaunchServerCommand}"
                                Background="#27272a" Foreground="#d4d4d8" 
                                FontWeight="SemiBold" FontSize="12"
                                Padding="10,9" CornerRadius="6"
                                ToolTip.Tip="{Binding Strings.HeaderLaunchServerTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN TABS CONTENT -->
            <TabControl Grid.Row="1" Margin="12,8,12,8">
                
                <!-- TAB 1: MOD INSTALLATE -->
                <TabItem Header="{Binding Strings.TabInstalledMods}">
                    <Grid RowDefinitions="Auto,*" Margin="8">
                        <!-- Actions bar with Debounced Search -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" 
                                     PlaceholderText="{Binding Strings.SearchInstalledPlaceholder}" 
                                     Text="{Binding InstalledSearchText}"
                                     Width="350" HorizontalAlignment="Left" />
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding Strings.InstallFromFileButton}"
                                        Click="OnInstallManualModFileClicked"
                                        Background="#3f3f46" Foreground="#d4d4d8" />
                                <Button Content="{Binding Strings.CheckUpdatesButton}" 
                                        Command="{Binding CheckUpdatesCommand}"
                                        Background="#27272a" />
                                <Button Content="{Binding Strings.UpdateAllModsButton}" 
                                        Command="{Binding UpdateAllModsCommand}"
                                        Background="#2563eb" Foreground="White" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <!-- Installed Mods List -->
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding InstalledMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstalledModItemViewModel">
                                        <Border Background="#27272a" CornerRadius="6" Padding="14,10" Margin="0,0,0,6"
                                                BorderBrush="#3f3f46" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                
                                                <!-- Toggle Switch -->
                                                <ToggleSwitch Grid.Column="0" 
                                                              IsChecked="{Binding IsEnabled}"
                                                              OnContent="" OffContent="" Margin="0,0,12,0" />

                                                <!-- Mod info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#f4f4f5" />
                                                        <Border Background="{Binding ProviderBadgeColor}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding ProviderBadgeText}" FontSize="10" Foreground="#f4f4f5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="#3f3f46" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding InstalledVersion, StringFormat='v{0}'}" FontSize="10" Foreground="#d4d4d8" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AuthorDisplay}" FontSize="11" Foreground="#a1a1aa" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Update badge -->
                                                <Border Grid.Column="2" 
                                                        IsVisible="{Binding HasUpdate}"
                                                        Background="#d97706" CornerRadius="4" Padding="8,4" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UpdateBadgeText}" 
                                                               Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>

                                                <!-- Update Button -->
                                                <Button Grid.Column="3" 
                                                        Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Strings.CommonUpdate}" 
                                                        IsVisible="{Binding HasUpdate}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UpdateModCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Background="#2563eb" Foreground="White" Margin="0,0,8,0" />

                                                <!-- Uninstall Button -->
                                                <Button Grid.Column="4" 
                                                        Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Strings.CommonUninstall}" 
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UninstallModCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Background="#7f1d1d" Foreground="#fca5a5" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- TAB 2: ESPLORA ONLINE (CON DEBOUNCE E MULTI-FONTE) -->
                <TabItem Header="{Binding Strings.TabOnlineCatalog}">
                    <Grid RowDefinitions="Auto,*" Margin="8">
                        <!-- Filters bar with Debounce and Source Dropdown -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" 
                                     PlaceholderText="{Binding Strings.SearchCatalogPlaceholder}" 
                                     Text="{Binding CatalogSearchText}"
                                     Margin="0,0,8,0" />
                            
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding SourceFilterOptions}"
                                      SelectedItem="{Binding SelectedSourceFilter}"
                                      Margin="0,0,8,0" Width="170" />
                            
                            <Button Grid.Column="2" 
                                    Content="{Binding Strings.RefreshCatalogButton}" 
                                    Command="{Binding RefreshOnlineCatalogCommand}"
                                    Background="#27272a" />
                        </Grid>

                        <!-- Catalog Items List with Multi-Source Grouping -->
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding CatalogMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogModItemViewModel">
                                        <Border Background="#27272a" CornerRadius="6" Padding="14,12" Margin="0,0,0,8"
                                                BorderBrush="#3f3f46" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                
                                                <!-- Details -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <!-- Title & Multi-Source Badges -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#f4f4f5" />
                                                        <TextBlock Text="{Binding AuthorDisplay}" FontSize="12" Foreground="#a1a1aa" VerticalAlignment="Center" />
                                                        
                                                        <!-- Sources Badges List -->
                                                        <ItemsControl ItemsSource="{Binding AvailableSources}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="m:ModSourceRelease">
                                                                    <Border Background="{Binding IsNewestOverall, Converter={x:Null}}"
                                                                            CornerRadius="4" Padding="6,2"
                                                                            BorderBrush="#3b82f6" BorderThickness="1">
                                                                        <TextBlock Text="{Binding .}" FontSize="10" Foreground="#93c5fd" FontWeight="Medium" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" 
                                                               Foreground="#d4d4d8" FontSize="12" Margin="0,4,0,6"
                                                               TextWrapping="Wrap" MaxLines="2" />

                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <TextBlock Text="{Binding DownloadsDisplay}" FontSize="11" Foreground="#a1a1aa" />
                                                        <TextBlock Text="{Binding RatingDisplay}" FontSize="11" Foreground="#a1a1aa" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Source Selector (se disponibile su più fonti) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" IsVisible="{Binding HasMultipleSources}">
                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Strings.ModSourceLabel}" FontSize="10" Foreground="#a1a1aa" Margin="0,0,0,2" />
                                                    <ComboBox ItemsSource="{Binding AvailableSources}"
                                                              SelectedItem="{Binding SelectedSource}"
                                                              Width="160" />
                                                </StackPanel>

                                                <!-- Version Selector -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Strings.ModVersionLabel}" FontSize="10" Foreground="#a1a1aa" Margin="0,0,0,2" />
                                                    <ComboBox ItemsSource="{Binding AvailableVersions}"
                                                              SelectedItem="{Binding SelectedVersion}"
                                                              Width="105" />
                                                </StackPanel>

                                                <!-- Install Button -->
                                                <Button Grid.Column="3" 
                                                        Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Strings.CommonInstall}" 
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).InstallModCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Background="#16a34a" Foreground="White" FontWeight="Bold"
                                                        Padding="16,10" CornerRadius="6" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- TAB 3: IMPOSTAZIONI & SELEZIONE MANUALE CARTELLA -->
                <TabItem Header="{Binding Strings.TabSettings}">
                    <ScrollViewer Margin="8">
                        <Grid ColumnDefinitions="*,360" Margin="4">
                            
                            <!-- COLONNA SINISTRA: AMBIENTE, CARTELLA & SORGENTI -->
                            <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,16,0">
                                
                                <!-- SELEZIONE LINGUA -->
                                <TextBlock Text="{Binding Strings.LanguageSectionTitle}" FontWeight="Bold" FontSize="14" Foreground="#e4e4e7" />
                                
                                <Border Background="#27272a" CornerRadius="6" Padding="16" BorderBrush="#3f3f46" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Strings.LanguageSectionDescription}" Foreground="#a1a1aa" FontSize="12" />
                                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                                  SelectedItem="{Binding SelectedLanguage}"
                                                  DisplayMemberBinding="{Binding DisplayName}"
                                                  Width="220" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Strings.GameFolderTitle}" FontWeight="Bold" FontSize="14" Foreground="#e4e4e7" />
                                
                                <Border Background="#27272a" CornerRadius="6" Padding="16" BorderBrush="#3f3f46" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Strings.GameFolderDescription}" Foreground="#a1a1aa" FontSize="12" />
                                        
                                        <!-- Manual input + Browse button -->
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding CustomGamePathInput}" Margin="0,0,8,0" PlaceholderText="{Binding Strings.GameFolderPlaceholder}" />
                                            <Button Grid.Column="1" Content="{Binding Strings.BrowseButton}" Click="OnBrowseGameFolderClicked" Background="#3f3f46" Margin="0,0,8,0" />
                                            <Button Grid.Column="2" Content="{Binding Strings.CommonSave}" Command="{Binding ApplyCustomGamePathCommand}" Background="#2563eb" Foreground="White" FontWeight="SemiBold" />
                                        </Grid>

                                        <Button Content="{Binding Strings.AutoDetectSteamButton}" 
                                                Command="{Binding DetectGame}" 
                                                Background="#27272a" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Strings.SourcesTitle}" FontWeight="Bold" FontSize="14" Foreground="#e4e4e7" Margin="0,10,0,0" />
                                
                                <Border Background="#27272a" CornerRadius="6" Padding="16" BorderBrush="#3f3f46" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="✅ Thunderstore" FontWeight="Bold" Foreground="#4ade80" />
                                            <TextBlock Text="{Binding Strings.SourcesThunderstoreStatus}" Foreground="#a1a1aa" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="✅ Hexium" FontWeight="Bold" Foreground="#4ade80" />
                                            <TextBlock Text="{Binding Strings.SourcesHexiumStatus}" Foreground="#a1a1aa" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⏳ Nexus Mods" FontWeight="Bold" Foreground="#facc15" />
                                            <TextBlock Text="{Binding Strings.SourcesNexusStatus}" Foreground="#a1a1aa" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- AGGIORNAMENTI APPLICAZIONE -->
                                <TextBlock Text="{Binding Strings.AppUpdateSectionTitle}" FontWeight="Bold" FontSize="14" Foreground="#e4e4e7" Margin="0,10,0,0" />
                                
                                <Border Background="#27272a" CornerRadius="6" Padding="16" BorderBrush="#3f3f46" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding FormattedCurrentAppVersion}" 
                                                           FontWeight="SemiBold" Foreground="#e4e4e7" FontSize="13" />
                                                <TextBlock Text="{Binding AppUpdateStatusText}" 
                                                           Foreground="#a1a1aa" FontSize="12" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="{Binding Strings.CheckAppUpdatesButton}" 
                                                        Command="{Binding CheckAppUpdateManualCommand}" 
                                                        IsEnabled="{Binding !IsAppUpdateChecking}"
                                                        Background="#3f3f46" Padding="10,6" FontSize="12" />

                                                <Button Content="{Binding FormattedDownloadAppUpdateButton}"
                                                        Command="{Binding ShowAppUpdateDialogCommand}"
                                                        IsVisible="{Binding IsAppUpdateAvailable}"
                                                        Background="#2563eb" Foreground="White" FontWeight="Bold" Padding="10,6" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- COLONNA DESTRA: OPZIONI DI AVVIO & PRESET RAPIDI -->
                            <StackPanel Grid.Column="1" Spacing="20">
                                <TextBlock Text="{Binding Strings.LaunchOptionsTitle}" FontWeight="Bold" FontSize="14" Foreground="#e4e4e7" />

                                <Border Background="#27272a" CornerRadius="6" Padding="16" BorderBrush="#3f3f46" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="{Binding Strings.LaunchOptionsDescription}" Foreground="#a1a1aa" FontSize="12" />
                                        
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding CustomLaunchArgsInput}" Margin="0,0,8,0" PlaceholderText="{Binding Strings.LaunchOptionsPlaceholder}" />
                                            <Button Grid.Column="1" Content="{Binding Strings.CommonSave}" Command="{Binding ApplyCustomLaunchArgsCommand}" Background="#2563eb" Foreground="White" FontWeight="SemiBold" />
                                        </Grid>

                                        <Separator Background="#3f3f46" Margin="0,2" />

                                        <!-- Quick Presets -->
                                        <TextBlock Text="{Binding Strings.QuickPresetsTitle}" FontWeight="SemiBold" Foreground="#d4d4d8" FontSize="12" />
                                        
                                        <WrapPanel Orientation="Horizontal" Margin="0,-2,0,0">
                                            <Button Content="+ -console" 
                                                    Command="{Binding AppendLaunchArgCommand}" 
                                                    CommandParameter="-console" 
                                                    Background="#3f3f46" Padding="8,4" FontSize="11" Margin="0,0,6,6"
                                                    ToolTip.Tip="{Binding Strings.TooltipPresetConsole}" />
                                            <Button Content="+ -window-mode exclusive" 
                                                    Command="{Binding AppendLaunchArgCommand}" 
                                                    CommandParameter="-window-mode exclusive" 
                                                    Background="#3f3f46" Padding="8,4" FontSize="11" Margin="0,0,6,6"
                                                    ToolTip.Tip="{Binding Strings.TooltipPresetExclusive}" />
                                            <Button Content="+ -force-vulkan" 
                                                    Command="{Binding AppendLaunchArgCommand}" 
                                                    CommandParameter="-force-vulkan" 
                                                    Background="#3f3f46" Padding="8,4" FontSize="11" Margin="0,0,6,6"
                                                    ToolTip.Tip="{Binding Strings.TooltipPresetVulkan}" />
                                        </WrapPanel>

                                        <Button Content="{Binding Strings.ClearLaunchOptionsButton}" 
                                                Command="{Binding ClearLaunchArgsCommand}" 
                                                Background="#27272a" Foreground="#ef4444" FontSize="11" Padding="8,4" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- BANNER NOTIFICA AGGIORNAMENTO A SCOMPARSA -->
            <Border Grid.Row="2" 
                    IsVisible="{Binding IsAppUpdateBannerVisible}"
                    Background="#1e3a8a" BorderBrush="#3b82f6" BorderThickness="0,1,0,1"
                    Padding="16,8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="🎉" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormattedUpdateBannerTitle}" FontWeight="Bold" Foreground="#bfdbfe" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LatestAppReleaseTitle}" Foreground="#93c5fd" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding FormattedInstallUpdateBanner}"
                            Command="{Binding ShowAppUpdateDialogCommand}"
                            Background="#2563eb" Foreground="White" FontWeight="Bold" FontSize="11"
                            Padding="12,5" CornerRadius="4" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Content="✕"
                            Command="{Binding DismissUpdateBannerCommand}"
                            Background="Transparent" Foreground="#93c5fd" FontSize="12"
                            Padding="6,4" ToolTip.Tip="{Binding Strings.FooterBannerDismissTooltip}" />
                </Grid>
            </Border>

            <!-- STATUS BAR -->
            <Border Grid.Row="3" Background="#18181b" Padding="12,6" BorderBrush="#27272a" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Width="150" Height="4" Margin="12,0,0,0" />
                </Grid>
            </Border>

        </Grid>

        <!-- MODAL OVERLAY: NUOVO PROFILO -->
        <Border Background="#80000000" IsVisible="{Binding IsNewProfileDialogVisible}" ZIndex="100">
            <Border Background="#27272a" CornerRadius="8" Padding="20" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#3f3f46" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Strings.NewProfileTitle}" FontWeight="Bold" FontSize="16" Foreground="#f4f4f5" />
                    <TextBlock Text="{Binding Strings.NewProfilePrompt}" FontSize="12" Foreground="#a1a1aa" />
                    <TextBox Text="{Binding NewProfileNameInput}" PlaceholderText="{Binding Strings.NewProfilePlaceholder}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="{Binding Strings.CommonCancel}" Command="{Binding CancelNewProfileDialogCommand}" Background="#3f3f46" />
                        <Button Content="{Binding Strings.CreateProfileButton}" Command="{Binding ConfirmNewProfileCommand}" Background="#16a34a" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: IMPORTA DA CODICE CONDIVISIONE VMM -->
        <Border Background="#80000000" IsVisible="{Binding IsImportShareCodeDialogVisible}" ZIndex="100">
            <Border Background="#27272a" CornerRadius="8" Padding="20" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#3f3f46" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Strings.ImportShareCodeTitle}" FontWeight="Bold" FontSize="16" Foreground="#f4f4f5" />
                    <TextBlock Text="{Binding Strings.ImportShareCodePrompt}" FontSize="12" Foreground="#a1a1aa" />
                    <TextBox Text="{Binding ShareCodeInput}" PlaceholderText="{Binding Strings.ImportShareCodePlaceholder}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="{Binding Strings.CommonCancel}" Command="{Binding CancelImportShareCodeDialogCommand}" Background="#3f3f46" />
                        <Button Content="{Binding Strings.ImportShareCodeButton}" Command="{Binding ConfirmImportShareCodeCommand}" Background="#16a34a" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: IMPORTA DA CODICE R2MODMAN -->
        <Border Background="#80000000" IsVisible="{Binding IsImportR2CodeDialogVisible}" ZIndex="100">
            <Border Background="#27272a" CornerRadius="8" Padding="20" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#3f3f46" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Strings.ImportR2Title}" FontWeight="Bold" FontSize="16" Foreground="#f4f4f5" />
                    <TextBlock Text="{Binding Strings.ImportR2Prompt}" FontSize="12" Foreground="#a1a1aa" />
                    <TextBox Text="{Binding R2CodeInput}" PlaceholderText="{Binding Strings.ImportR2Placeholder}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="{Binding Strings.CommonCancel}" Command="{Binding CancelImportR2CodeDialogCommand}" Background="#3f3f46" />
                        <Button Content="{Binding Strings.ImportR2Button}" Command="{Binding ConfirmImportR2CodeCommand}" Background="#2563eb" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: CONDIVIDI PROFILO CON CODICE -->
        <Border Background="#80000000" IsVisible="{Binding IsShareProfileDialogVisible}" ZIndex="100">
            <Border Background="#27272a" CornerRadius="8" Padding="20" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#3f3f46" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Strings.ShareProfileTitle}" FontWeight="Bold" FontSize="16" Foreground="#f4f4f5" />
                    <TextBlock Text="{Binding Strings.ShareProfilePrompt}" FontSize="12" Foreground="#a1a1aa" />
                    <TextBox Text="{Binding GeneratedShareCode}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                             Background="#18181b" Foreground="#93c5fd" FontFamily="Consolas,Monospace" FontSize="11" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding Strings.ShareProfileCopiedTooltip}" 
                                   IsVisible="{Binding IsShareCodeCopied}" Foreground="#22c55e" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{Binding Strings.ShareProfileCopyButton}" 
                                Command="{Binding CopyGeneratedShareCodeCommand}" 
                                Background="#2563eb" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="{Binding Strings.CommonClose}" 
                                Command="{Binding DismissShareProfileDialogCommand}" 
                                Background="#3f3f46" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: AGGIORNAMENTO APPLICAZIONE -->
        <Border Background="#80000000" IsVisible="{Binding IsAppUpdateDialogVisible}" ZIndex="100">
            <Border Background="#27272a" CornerRadius="8" Padding="22" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#3f3f46" BorderThickness="1">
                <StackPanel Spacing="14">
                    <!-- Title and badge -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Strings.AppUpdateDialogTitle}" FontWeight="Bold" FontSize="18" Foreground="#f4f4f5" />
                            <TextBlock Text="{Binding LatestAppReleaseTitle}" Foreground="#93c5fd" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1e3a8a" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                            <TextBlock Text="{Binding LatestAppVersion, StringFormat='v{0}'}" FontWeight="Bold" Foreground="#60a5fa" FontSize="12" />
                        </Border>
                    </Grid>

                    <!-- Changelog box -->
                    <TextBlock Text="{Binding Strings.ReleaseNotesLabel}" FontSize="12" Foreground="#a1a1aa" FontWeight="SemiBold" />
                    <Border Background="#18181b" CornerRadius="6" Padding="12" MaxHeight="160" BorderBrush="#3f3f46" BorderThickness="1">
                        <ScrollViewer>
                            <TextBlock Text="{Binding LatestAppReleaseNotes}" TextWrapping="Wrap" Foreground="#d4d4d8" FontSize="12" />
                        </ScrollViewer>
                    </Border>

                    <!-- Download progress if downloading -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsAppUpdateDownloading}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Strings.DownloadingPackageLabel}" Foreground="#a1a1aa" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding AppUpdateDownloadProgress, StringFormat='{}{0:0}%'}" Foreground="#60a5fa" FontSize="11" FontWeight="Bold" />
                        </Grid>
                        <ProgressBar Value="{Binding AppUpdateDownloadProgress}" Minimum="0" Maximum="100" Height="6" />
                    </StackPanel>

                    <!-- Success download banner -->
                    <Border Background="#064e3b" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10"
                            IsVisible="{Binding DownloadedAppPackagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Strings.PackageDownloadedSuccess}" FontWeight="Bold" Foreground="#a7f3d0" FontSize="12" />
                                <TextBlock Text="{Binding DownloadedAppPackagePath}" TextTrimming="CharacterEllipsis" Foreground="#6ee7b7" FontSize="10" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding Strings.OpenFolderButton}" Command="{Binding OpenDownloadedUpdateCommand}"
                                    Background="#047857" Foreground="White" FontSize="11" Padding="8,4" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="{Binding Strings.GitHubPageButton}" Command="{Binding OpenGitHubReleasePageCommand}" Background="#3f3f46" FontSize="12" />
                        
                        <Button Grid.Column="2" Content="{Binding Strings.CommonClose}" Command="{Binding DismissAppUpdateDialogCommand}" Background="#3f3f46" Margin="0,0,8,0" FontSize="12" />
                        <Button Grid.Column="3" Content="{Binding Strings.DownloadPackageButton}" 
                                Command="{Binding DownloadAppUpdateCommand}" 
                                IsEnabled="{Binding !IsAppUpdateDownloading}"
                                Background="#2563eb" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</Window>
